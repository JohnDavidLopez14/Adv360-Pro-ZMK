#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        dvorak_mac {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1         &kp N2     &kp N3      &kp N4     &kp N5  &tog 2                                                                      &mo 4      &kp N6  &kp N7  &kp N8    &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp SQT        &kp COMMA  &kp PERIOD  &kp P      &kp Y   &tog 3                                                                      &none      &kp F   &kp G   &kp C     &kp R     &kp L     &kp SLASH
&kp ESC    &kp A          &kp O      &kp E       &kp U      &kp I   &none     &kp LEFT_GUI  &kp LALT      &kp RIGHT_CONTROL  &kp RIGHT_COMMAND  &none      &kp D   &kp H   &kp T     &kp N     &kp S     &kp BACKSLASH
&kp LSHFT  &kp SEMICOLON  &kp Q      &kp J       &kp K      &kp X                           &kp HOME      &kp PG_UP                                        &kp B   &kp M   &kp W     &kp V     &kp Z     &kp RSHFT
&mo 1      &kp GRAVE      &kp CAPS   &kp LEFT    &kp RIGHT          &kp BSPC  &kp DEL       &kp END       &kp PG_DN          &kp ENTER          &kp SPACE          &kp UP  &kp DOWN  &kp LBKT  &kp RBKT  &mo 1
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3            &kp F4          &kp F5      &kp F6  &tog 2                                      &mo 4   &kp F7  &kp F8           &kp F9             &kp F10     &kp F11  &kp F12
&trans  &trans  &trans            &trans          &trans      &trans  &tog 3                                      &none   &trans  &trans           &trans             &trans      &trans   &trans
&trans  &trans  &kp C_PLAY_PAUSE  &kp C_PREVIOUS  &kp C_NEXT  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp C_MUTE  &trans   &trans
&trans  &trans  &trans            &trans          &trans      &trans                  &trans      &trans                  &trans  &trans           &trans             &trans      &trans   &trans
&trans  &trans  &trans            &trans          &trans              &trans  &trans  &trans      &trans  &trans  &trans          &trans           &trans             &trans      &trans   &trans
            >;
        };

        dvorak_windows {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1         &kp N2     &kp N3      &kp N4     &kp N5  &tog 2                                                                          &mo 4      &kp N6  &kp N7  &kp N8    &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp SQT        &kp COMMA  &kp PERIOD  &kp P      &kp Y   &tog 3                                                                          &none      &kp F   &kp G   &kp C     &kp R     &kp L     &kp SLASH
&kp ESC    &kp A          &kp O      &kp E       &kp U      &kp I   &none     &kp LEFT_CONTROL  &kp LEFT_ALT      &kp RIGHT_GUI  &kp RIGHT_CONTROL  &none      &kp D   &kp H   &kp T     &kp N     &kp S     &kp BACKSLASH
&kp LSHFT  &kp SEMICOLON  &kp Q      &kp J       &kp K      &kp X                               &kp HOME          &kp PG_UP                                    &kp B   &kp M   &kp W     &kp V     &kp Z     &kp RSHFT
&mo 1      &kp GRAVE      &kp CAPS   &kp LEFT    &kp RIGHT          &kp BSPC  &kp DEL           &kp END           &kp PG_DN      &kp ENTER          &kp SPACE          &kp UP  &kp DOWN  &kp LBKT  &kp RBKT  &mo 1
            >;
        };

        windows_gaming {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1         &kp N2     &kp N3      &kp N4     &kp N5  &tog 2                                                                       &mo 4      &kp N6  &kp N7  &kp N8    &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp SQT        &kp COMMA  &kp PERIOD  &kp P      &kp Y   &tog 3                                                                       &none      &kp F   &kp G   &kp C     &kp R     &kp L     &kp SLASH
&kp ESC    &kp A          &kp O      &kp E       &kp U      &kp I   &none      &kp LEFT_GUI  &kp LALT      &kp RIGHT_CONTROL  &kp RIGHT_COMMAND  &none      &kp D   &kp H   &kp T     &kp N     &kp S     &kp BACKSLASH
&kp LSHFT  &kp SEMICOLON  &kp Q      &kp J       &kp K      &kp X                            &kp HOME      &kp PG_UP                                        &kp B   &kp M   &kp W     &kp V     &kp Z     &kp RSHFT
&mo 1      &kp GRAVE      &kp CAPS   &kp LEFT    &kp RIGHT          &kp SPACE  &kp DEL       &kp END       &kp PG_DN          &kp ENTER          &kp SPACE          &kp UP  &kp DOWN  &kp LBKT  &kp RBKT  &mo 1
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
